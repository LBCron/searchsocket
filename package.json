{
  "name": "searchsocket",
  "version": "1.0.0",
  "description": "Semantic site search and MCP retrieval for SvelteKit static sites",
  "license": "MIT",
  "author": "Greg Priday <greg@siteorigin.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gregpriday/searchsocket.git"
  },
  "homepage": "https://github.com/gregpriday/searchsocket",
  "bugs": {
    "url": "https://github.com/gregpriday/searchsocket/issues"
  },
  "keywords": [
    "search",
    "semantic-search",
    "sveltekit",
    "mcp",
    "embeddings",
    "vector-search",
    "site-search",
    "static-site"
  ],
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.map",
    "src/svelte",
    "src/types.ts",
    "src/utils/structured-meta.ts",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "searchsocket": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./sveltekit": {
      "import": {
        "types": "./dist/sveltekit.d.ts",
        "default": "./dist/sveltekit.js"
      },
      "require": {
        "types": "./dist/sveltekit.d.cts",
        "default": "./dist/sveltekit.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./scroll": {
      "import": {
        "types": "./dist/scroll.d.ts",
        "default": "./dist/scroll.js"
      },
      "require": {
        "types": "./dist/scroll.d.cts",
        "default": "./dist/scroll.cjs"
      }
    },
    "./svelte": {
      "types": "./src/svelte/index.svelte.ts",
      "svelte": "./src/svelte/index.svelte.ts",
      "default": "./src/svelte/index.svelte.ts"
    }
  },
  "peerDependencies": {
    "svelte": "^5.20.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/sync-templates.mjs && tsup",
    "sync:templates": "node scripts/sync-templates.mjs",
    "prepare": "npm run build",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:quality": "SEARCHSOCKET_QUALITY_TESTS=1 vitest run tests/quality.test.ts",
    "check:package": "node scripts/check-package.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test && pnpm run check:package"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.29.2",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@upstash/vector": "^1.2.3",
    "cheerio": "^1.2.0",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "jiti": "^2.7.0",
    "magicast": "^0.5.5",
    "p-limit": "^7.3.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.7",
    "@types/turndown": "^5.0.6",
    "jsdom": "^28.1.0",
    "svelte": "^5.57.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
